# Suwa PHM • MOH & PHNS Web Supervision Dashboard Environment Configuration
# When left blank or unconfigured, the application runs automatically in Offline Demo Mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Only Service Role Key (Used exclusively by server Route Handlers for admin user provisioning)
# NEVER expose this key in NEXT_PUBLIC_ variables!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
